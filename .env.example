# Database (Render postgres)
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tourism_db
DB_USER=render_user
DB_PASSWORD=render_password
# If provided, overrides above (Render injects automatically)
DATABASE_URL=postgres://render_user:render_password@localhost:5432/tourism_db

# External APIs (set in Render Dashboard → Environment) 
EXTERNAL_API_MODE=live
EXTERNAL_HOTEL_API=https://test.api.amadeus.com/v1/reference-data/locations/hotels/by-city
EXTERNAL_HOTEL_API_TOKEN=your_amadeus_access_token_here
EXTERNAL_HOTEL_CLIENT_ID=your_amadeus_client_id_here
EXTERNAL_HOTEL_CLIENT_SECRET=your_amadeus_client_secret_here

# Restaurants (Yelp Fusion example)
EXTERNAL_RESTAURANT_API=https://api.yelp.com/v3/businesses/search
EXTERNAL_RESTAURANT_API_TOKEN=your_yelp_api_key_here

# Taxi/Routing (OpenRouteService example)
EXTERNAL_TAXI_API=https://api.openrouteservice.org/v2/directions/driving-car
EXTERNAL_TAXI_API_KEY=your_openrouteservice_api_key_here
